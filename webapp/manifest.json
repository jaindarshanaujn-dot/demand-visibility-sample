{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.saputo.demandvisibility",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Demand Visibility Sample",
    "description": "Sample Fiori app for demand visibility from Excel-backed OData mock service",
    "crossNavigation": {
      "inbounds": {
        "display": {
          "semanticObject": "DemandVisibility",
          "action": "display",
          "title": "Demand Visibility Sample",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/mock/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.comp": {},
        "sap.ui.table": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": {
          "defaultCountMode": "Inline",
          "useBatch": false
        }
      }
    },
    "rootView": {
      "viewName": "com.saputo.demandvisibility.view.Main",
      "type": "XML",
      "height": "100%",
      "displayBlock": true,
      "async": true,
      "id": "main"
    }
  }
}
